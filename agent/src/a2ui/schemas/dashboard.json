[
  {
    "id": "root",
    "component": "Stack",
    "gap": "lg",
    "children": [
      "snapshot-section",
      "scope-chips",
      "kpi-grid",
      "signals-grid",
      "risk-section",
      "diligence-section",
      "team-section"
    ]
  },
  {
    "id": "snapshot-section",
    "component": "Section",
    "eyebrow": "FUNDLENS AI",
    "title": "Investment Snapshot",
    "child": "header-card"
  },
  {
    "id": "header-card",
    "component": "Card",
    "tone": "mint",
    "child": "header-stack"
  },
  {
    "id": "header-stack",
    "component": "Stack",
    "gap": "sm",
    "children": ["header-eyebrow", "header-heading", "header-text"]
  },
  {
    "id": "header-eyebrow",
    "component": "Overline",
    "text": { "path": "/eyebrow" }
  },
  {
    "id": "header-heading",
    "component": "Heading",
    "level": "1",
    "text": { "path": "/title" }
  },
  {
    "id": "header-text",
    "component": "Text",
    "tone": "muted",
    "text": { "path": "/subtitle" }
  },
  {
    "id": "scope-chips",
    "component": "ChoiceChips",
    "label": "Investment view",
    "value": { "path": "/scope/selected" },
    "options": { "path": "/scope/options" }
  },
  {
    "id": "kpi-grid",
    "component": "Grid",
    "columns": 4,
    "gap": "md",
    "children": ["kpi-1", "kpi-2", "kpi-3", "kpi-4"]
  },
  {
    "id": "kpi-1",
    "component": "StatCard",
    "label": { "path": "/kpis/0/label" },
    "value": { "path": "/kpis/0/value" },
    "delta": { "path": "/kpis/0/delta" },
    "deltaTone": "neutral",
    "caption": { "path": "/kpis/0/caption" }
  },
  {
    "id": "kpi-2",
    "component": "StatCard",
    "label": { "path": "/kpis/1/label" },
    "value": { "path": "/kpis/1/value" },
    "delta": { "path": "/kpis/1/delta" },
    "deltaTone": "positive",
    "caption": { "path": "/kpis/1/caption" }
  },
  {
    "id": "kpi-3",
    "component": "StatCard",
    "label": { "path": "/kpis/2/label" },
    "value": { "path": "/kpis/2/value" },
    "delta": { "path": "/kpis/2/delta" },
    "deltaTone": "neutral",
    "caption": { "path": "/kpis/2/caption" }
  },
  {
    "id": "kpi-4",
    "component": "StatCard",
    "label": { "path": "/kpis/3/label" },
    "value": { "path": "/kpis/3/value" },
    "delta": { "path": "/kpis/3/delta" },
    "deltaTone": "neutral",
    "caption": { "path": "/kpis/3/caption" }
  },
  {
    "id": "signals-grid",
    "component": "Grid",
    "columns": 2,
    "gap": "md",
    "children": ["traction-section", "market-section"]
  },
  {
    "id": "traction-section",
    "component": "Section",
    "eyebrow": "TRACTION SIGNALS",
    "title": "Revenue / Growth Evidence",
    "child": "traction-card"
  },
  {
    "id": "traction-card",
    "component": "Card",
    "child": "traction-chart"
  },
  {
    "id": "traction-chart",
    "component": "LineChart",
    "height": 240,
    "data": { "path": "/trend" }
  },
  {
    "id": "market-section",
    "component": "Section",
    "eyebrow": "MARKET OPPORTUNITY",
    "title": "Market / Segment Signals",
    "child": "market-card"
  },
  {
    "id": "market-card",
    "component": "Card",
    "child": "market-chart"
  },
  {
    "id": "market-chart",
    "component": "DonutChart",
    "height": 240,
    "data": { "path": "/share" }
  },
  {
    "id": "risk-section",
    "component": "Section",
    "eyebrow": "RISK REGISTER",
    "title": "Main Investor Risks",
    "child": "risk-card"
  },
  {
    "id": "risk-card",
    "component": "Card",
    "child": "risk-table"
  },
  {
    "id": "risk-table",
    "component": "DataTable",
    "columns": [
      { "key": "name", "label": "Risk", "align": "left" },
      { "key": "category", "label": "Area", "align": "left" },
      { "key": "value", "label": "Evidence", "align": "left" },
      { "key": "delta", "label": "Priority", "align": "right" }
    ],
    "rows": { "path": "/rows" }
  },
  {
    "id": "diligence-section",
    "component": "Section",
    "eyebrow": "DUE DILIGENCE QUESTIONS",
    "title": "Questions for the Founder",
    "child": "diligence-card"
  },
  {
    "id": "diligence-card",
    "component": "Card",
    "child": "diligence-table"
  },
  {
    "id": "diligence-table",
    "component": "DataTable",
    "columns": [
      { "key": "name", "label": "Question", "align": "left" },
      { "key": "category", "label": "Priority", "align": "left" },
      { "key": "value", "label": "Why it matters", "align": "left" },
      { "key": "delta", "label": "Urgency", "align": "right" }
    ],
    "rows": { "path": "/questions" }
  },
  {
    "id": "team-section",
    "component": "Section",
    "eyebrow": "FOUNDER / TEAM SIGNALS",
    "title": "Team Strengths",
    "child": "team-card"
  },
  {
    "id": "team-card",
    "component": "Card",
    "tone": "lilac",
    "child": "team-callout"
  },
  {
    "id": "team-callout",
    "component": "Callout",
    "tone": "neutral",
    "title": "Team readout",
    "body": { "path": "/team_signals" }
  }
]
